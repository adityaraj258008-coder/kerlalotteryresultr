# GEMINI_API_KEY: Optional (only if AI features are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (e.g. your Netlify site URL).
APP_URL="MY_APP_URL"

# Supabase Database Connection (Set these in Netlify Site Settings -> Environment Variables)
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
# Optional server-side service role key (recommended on Netlify for unrestricted server sync)
SUPABASE_SERVICE_ROLE_KEY=""

# Admin Session & Credentials (Recommended to set on Netlify Site Settings -> Environment Variables)
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
ADMIN_USERNAME="Ankushraj"
ADMIN_PASSWORD="REPLACE_WITH_YOUR_ADMIN_PASSWORD"
